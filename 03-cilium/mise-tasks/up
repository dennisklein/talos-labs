#!/usr/bin/env bash
#MISE description="Talos in Docker without Flannel and kube-proxy; Cilium as CNI with kube-proxy replacement"
#MISE depends=["//:preflight"]
source "$LAB_ROOT/lib/lab.sh"

# The configuration has no CNI. cluster create sees this and skips the checks for Ready nodes,
# kube-proxy and CoreDNS. Thus, it ends with NotReady nodes, and Cilium goes in after it.
talos_up_docker --workers 2
cilium_up
mise run check
